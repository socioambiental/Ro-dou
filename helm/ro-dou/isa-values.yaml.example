# Exemplo de values para a instalação ISA.
# Copie para isa-values.yaml, preencha os valores e NUNCA versione esse arquivo.

postgres:
  external:
    enabled: true
    host: "<ip-do-servidor-postgres>"
  secrets:
    postgres-user: "rodou"
    postgres-password: "<senha-do-usuario-rodou-no-postgres>"
    postgres-db: "rodou"

gitRsync:
  enabled: true
  repository: "https://github.com/socioambiental/dags-rodou"
  branch: main
  sourceDir: ""          # subpasta do repo, ou vazio para sincronizar a raiz
  secret:
    name: "git-token-secret"   # Secret com chave "token" contendo o GitHub token
    key: token
  persistence:
    storageClassName: "<storage-class-do-cluster>"

airflow:
  # Imagem do ISA (fork socioambiental/Ro-dou), no Harbor. Sem isto vale a imagem pública
  # ghcr.io/gestaogovbr/ro-dou:latest, que não tem as mudanças do ISA.
  # Gerar: docker build -t harbor.ad.socioambiental.org/imagens/ro-dou:<versão>-isa.<n> .
  image:
    repository: harbor.ad.socioambiental.org/imagens/ro-dou
    tag: "0.13.2-isa.1"
    pullPolicy: IfNotPresent
  apiServer:
    service:
      type: LoadBalancer   # expõe o Airflow via IP externo no VKS

  pvc:
    storageClassName: "<storage-class-do-cluster>"

  # fsGroup: 0 necessário para o usuário airflow (gid 0) escrever nos PVCs vSphere RWO
  podSecurityContext:
    fsGroup: 0

  # PVCs são RWO — todos os pods Airflow precisam estar no mesmo nó
  nodeSelector:
    kubernetes.io/hostname: "<nome-do-no-onde-os-pvcs-estao-montados>"

  config:
    AIRFLOW__API__BASE_URL: "http://<ip-externo-do-airflow>:8080"
    AIRFLOW__WEBSERVER__BASE_URL: "http://<ip-externo-do-airflow>:8080"

  secrets:
    AIRFLOW__CORE__FERNET_KEY: "<gere com: python3 -c \"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\">"
    AIRFLOW__API_AUTH__JWT_SECRET: "<string aleatória longa>"
    AIRFLOW__API__SECRET_KEY: "<string aleatória longa>"
    _AIRFLOW_WWW_USER_USERNAME: "admin"
    _AIRFLOW_WWW_USER_PASSWORD: "<senha-forte>"
    AIRFLOW__SMTP__SMTP_HOST: "smtp.mandrillapp.com"
    AIRFLOW__SMTP__SMTP_MAIL_FROM: "ISA-BOT DIÁRIO OFICIAL <bot-dou@socioambiental.org>"
    AIRFLOW__SMTP__SMTP_PORT: "587"
    AIRFLOW__SMTP__SMTP_STARTTLS: "true"
    AIRFLOW__SMTP__SMTP_USER: "<email-conta-mandrill>"
    AIRFLOW__SMTP__SMTP_PASSWORD: "<api-key-mandrill>"
    INLABS_PORTAL_LOGIN: "<login-inlabs>"
    INLABS_PORTAL_PASSWORD: "<senha-inlabs>"

smtp4dev:
  enabled: false   # desligado pois usamos SMTP real (Mandrill)
